{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IWIG Content Package v2",
  "type": "object",
  "required": ["schema", "schema_version", "status", "capture_status", "processing_status", "active_errors", "error_history", "identity", "source", "post", "media", "derived", "field_provenance", "completeness", "processing", "runtime", "errors", "limitations"],
  "properties": {
    "schema": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "iwig-content-package"}, "version": {"const": "2.0.0"}}},
    "schema_version": {"const": 2}, "status": {"enum": ["completed", "partial", "failed"]},
    "capture_status": {"enum": ["completed", "partial", "failed"]},
    "processing_status": {"enum": ["not_run", "completed", "partial", "failed"]},
    "active_errors": {"type": "array", "items": {"type": "object", "required": ["stage", "code"]}},
    "error_history": {"type": "array", "items": {"type": "object", "required": ["stage", "code"]}},
    "identity": {"type": "object"}, "source": {"type": "object"}, "post": {"type": "object"},
    "media": {"type": "object"}, "derived": {"type": "object"}, "field_provenance": {"type": "object"},
    "completeness": {"type": "object", "additionalProperties": {"type": "object", "required": ["status", "count", "reason"], "properties": {"status": {"enum": ["available", "partial", "zero", "not_exposed", "intentionally_omitted", "failed", "not_run"]}, "count": {"type": ["integer", "null"]}, "reason": {"type": ["string", "null"]}}}},
    "processing": {"type": "object"}, "runtime": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "object", "required": ["stage", "code"]}}, "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
